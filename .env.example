# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM provider selection: mock | ollama | api ---
COPTHIEF_LLM_PROVIDER=mock

# Cloud LLM API (used when provider=api). Only one is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama base URL (used when provider=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- MCP shared auth token (rotate/revoke to cut off access) ---
COPTHIEF_MCP_TOKEN=change-me-please

# --- Gmail API (report email). Path to OAuth client secret JSON. ---
GMAIL_CLIENT_SECRET_FILE=client_secret.json
GMAIL_TOKEN_FILE=token.json
