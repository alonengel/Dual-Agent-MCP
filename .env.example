# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM provider selection: mock | claude | ollama | api ---
# 'claude' uses the Claude CLI if installed, else the Anthropic API (key below).
COPTHIEF_LLM_PROVIDER=claude

# Optional: explicit path to the Claude CLI (otherwise resolved from PATH).
CLAUDE_CLI_PATH=

# Cloud LLM API keys. For provider=claude only ANTHROPIC_API_KEY is used (fallback).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama base URL (used when provider=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- MCP shared auth token (rotate/revoke to cut off access) ---
COPTHIEF_MCP_TOKEN=change-me-please

# Optional: override MCP server URLs without editing config.yaml (tunnel / combined mode).
# COPTHIEF_COP_URL=https://<id>.trycloudflare.com/cop/mcp
# COPTHIEF_THIEF_URL=https://<id>.trycloudflare.com/thief/mcp

# --- Gmail API (report email). Follows the course Gmail-API guide. ---
# Download the OAuth Desktop client and save it as credentials.json (gmail.modify scope).
GMAIL_CLIENT_SECRET_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
